# Copy to .env.local and adjust.
# api  (default) = call the FastAPI backend
# mock           = sample knowledge base in the browser, no backend needed
VITE_ASSISTANT_MODE=api
# Where the dev server proxies /api and /health.
VITE_BACKEND_URL=http://localhost:8000
# Optional: call the backend directly instead of through the dev proxy (e.g. a deployed build).
# The backend's ALLOWED_ORIGINS must then include the frontend's origin.
# VITE_API_BASE_URL=https://assistant-api.example.org
